# Copy to `.env` next to docker-compose.yml. These drive compose only.
# Replace <ELASTIC_IP> with your allocated Elastic IP (dots kept).
#
# sslip.io turns an IP into a hostname that resolves back to it, so Caddy can
# get a valid HTTPS cert without you buying a domain.

SITE_ADDRESS=<ELASTIC_IP>.sslip.io
PUBLIC_ORIGIN=https://<ELASTIC_IP>.sslip.io
